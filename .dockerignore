# Allowlist: the build context is exactly what the Dockerfile reads. Everything
# is excluded, then the inputs are named one by one, so a new file in the repo
# (docs, tests, local data, secrets) never slips into the context or the image.
*

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!src/
!views/
!public/
!assets/
!scripts/postinstall.js
!scripts/build-js.js
!scripts/prune-prod-deps.js

# Build outputs are produced inside the image, never copied in from a dev tree.
public/dist
public/css/app.css

# Editor and OS clutter that can sit inside the allowed folders.
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*~
